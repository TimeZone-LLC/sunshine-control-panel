{
  "name": "sunshine-gui",
  "version": "0.0.0-dev",
  "description": "A GUI for sunshine",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1 -Configuration Debug && tauri dev",
    "dev-webui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1 -Configuration Debug && cross-env WEBUI_DEV_TARGET=https://localhost:3000 tauri dev",
    "dev:renderer": "vite --config vite.config.js",
    "test:renderer": "node --test",
    "build": "npm run build:native-plugins && tauri build",
    "build:renderer": "vite build --config vite.config.js",
    "build:native-plugins": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1",
    "build:win": "npm run build:component:win",
    "build:component:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-gui-component-installer.ps1",
    "build:beta": "npm run build:native-plugins && cross-env BETA=true npm run build:renderer && tauri build --features beta",
    "build:beta:win": "cross-env BETA=true powershell -ExecutionPolicy Bypass -File ./scripts/build-gui-component-installer.ps1 -Beta"
  },
  "repository": "https://github.com/qiin2333/sunshine",
  "author": {
    "name": "qiin2333",
    "url": "https://github.com/qiin2333"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "less": "^4.6.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43"
  },
  "overrides": {
    "@vueuse/core": "14.4.0"
  }
}
